{
  "name": "showroom-pro-api-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && npm run build && npm run start",
    "build": "node ./build.mjs",
    "start": "node --env-file=../.env --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
